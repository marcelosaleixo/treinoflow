# Exemplo local: defina os valores no ambiente ou no EasyPanel.
DB_URL=jdbc:postgresql://localhost:5432/treinoflow
DB_USERNAME=postgres
# Informe a senha REAL configurada para esse usuário no PostgreSQL.
DB_PASSWORD=COLOQUE_A_SENHA_REAL_DO_POSTGRES
# Alternativa padrão Docker/PostgreSQL (se disponível no ambiente da aplicação):
# POSTGRES_PASSWORD=COLOQUE_A_SENHA_REAL_DO_POSTGRES
DDL_AUTO=update
SHOW_SQL=false
PORT=8080

# EasyPanel / Nixpacks
NIXPACKS_JDK_VERSION=21

# Provisionamento do administrador Master
TREINOFLOW_MASTER_EMAIL=admin@treinoflow.com.br
TREINOFLOW_MASTER_PASSWORD=troque-por-uma-senha-com-no-minimo-12-caracteres

# Etapas 191–208: alertas operacionais por e-mail e recuperação da fila
# Mantenha false até concluir o teste SMTP em homologação.
TREINOFLOW_EMAIL_ENABLED=false
TREINOFLOW_ALERTAS_EMAIL_DESTINO=
TREINOFLOW_SMTP_HOST=
TREINOFLOW_SMTP_PORT=587
TREINOFLOW_SMTP_USERNAME=
TREINOFLOW_SMTP_PASSWORD=
TREINOFLOW_SMTP_AUTH=true
TREINOFLOW_SMTP_STARTTLS=true
TREINOFLOW_ALERTAS_EMAIL_MAX_TENTATIVAS=4
TREINOFLOW_ALERTAS_EMAIL_INTERVALO_MS=30000

# Retenção de auditoria de preferências (desativada por padrão)
TREINOFLOW_AUDITORIA_PREFERENCIAS_ENABLED=false
TREINOFLOW_AUDITORIA_PREFERENCIAS_RETENCAO_DIAS=365
TREINOFLOW_AUDITORIA_PREFERENCIAS_CRON=0 30 3 * * *
